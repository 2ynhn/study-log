rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isLinkedParent(studentUid) {
      return exists(/databases/$(database)/documents/links/$(studentUid + '_' + request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isLinkedParent(userId));
      allow write: if isSignedIn() && request.auth.uid == userId;
      // 연결된 학부모가 학생에게 응원 메시지를 보낼 수 있도록, cheerMessage 필드만 제한적으로 쓰기 허용
      allow update: if isSignedIn() && isLinkedParent(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cheerMessage']) &&
        request.resource.data.cheerMessage.fromParentUid == request.auth.uid &&
        request.resource.data.cheerMessage.read == false;

      match /inviteCodes/{code} {
        // 학부모가 코드를 입력해 자녀를 찾으려면 본인 소유가 아닌 코드도 조회할 수 있어야 함
        allow get, list: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
        // 학부모가 미사용 코드를 본인 명의로 1회 사용 처리하는 것만 허용 (그 외 필드는 본인만 수정)
        allow update: if isSignedIn() && (
          request.auth.uid == userId ||
          (
            resource.data.used == false &&
            request.resource.data.used == true &&
            request.resource.data.usedByParentUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedByParentUid'])
          )
        );
      }

      match /studyRecords/{recordId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isLinkedParent(userId));
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // collectionGroup('inviteCodes') 쿼리(부모가 코드로 학생을 찾는 로직)는 위의
    // 중첩 match만으로는 list 권한이 적용되지 않아, 와일드카드 경로로 별도 허용해야 함
    match /{path=**}/inviteCodes/{code} {
      allow list: if isSignedIn();
    }

    // 아이디 로그인을 유지하면서 실제 이메일 계정을 쓰기 위한 아이디 -> 이메일 매핑.
    // 로그인/비밀번호 찾기 시 로그인 전 상태에서 조회해야 하므로 get은 누구나 허용하되,
    // list는 막아 전체 아이디 목록을 긁어갈 수 없게 한다. 본인 명의로만 1회 생성 가능, 이후 불변.
    match /usernames/{loginId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    match /links/{linkId} {
      allow read: if isSignedIn() &&
        (resource.data.studentUid == request.auth.uid || resource.data.parentUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.parentUid == request.auth.uid &&
        linkId == request.resource.data.studentUid + '_' + request.resource.data.parentUid;
      allow delete: if isSignedIn() && resource.data.studentUid == request.auth.uid;
    }
  }
}
