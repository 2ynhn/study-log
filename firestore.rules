rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isLinkedParent(studentUid) {
      return exists(/databases/$(database)/documents/links/$(studentUid + '_' + request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isLinkedParent(userId));
      allow write: if isSignedIn() && request.auth.uid == userId;

      match /inviteCodes/{code} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /studyRecords/{recordId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isLinkedParent(userId));
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /links/{linkId} {
      allow read: if isSignedIn() &&
        (resource.data.studentUid == request.auth.uid || resource.data.parentUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.parentUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.studentUid == request.auth.uid;
    }
  }
}
