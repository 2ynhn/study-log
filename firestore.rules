rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isLinkedParent(studentUid) {
      return exists(/databases/$(database)/documents/links/$(studentUid + '_' + request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isLinkedParent(userId));
      allow write: if isSignedIn() && request.auth.uid == userId;

      match /inviteCodes/{code} {
        // 학부모가 코드를 입력해 자녀를 찾으려면 본인 소유가 아닌 코드도 조회할 수 있어야 함
        allow get, list: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
        // 학부모가 미사용 코드를 본인 명의로 1회 사용 처리하는 것만 허용 (그 외 필드는 본인만 수정)
        allow update: if isSignedIn() && (
          request.auth.uid == userId ||
          (
            resource.data.used == false &&
            request.resource.data.used == true &&
            request.resource.data.usedByParentUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedByParentUid'])
          )
        );
      }

      match /studyRecords/{recordId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isLinkedParent(userId));
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /links/{linkId} {
      allow read: if isSignedIn() &&
        (resource.data.studentUid == request.auth.uid || resource.data.parentUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.parentUid == request.auth.uid &&
        linkId == request.resource.data.studentUid + '_' + request.resource.data.parentUid;
      allow delete: if isSignedIn() && resource.data.studentUid == request.auth.uid;
    }
  }
}
